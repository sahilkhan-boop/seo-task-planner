# Copy to .env (gitignored) and fill in. See README's "GSC connection setup" section
# for how to create these in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# From console.anthropic.com -> API Keys. Powers the plan-editing chat feature.
ANTHROPIC_API_KEY=

# Signs the login session cookie -- set a real, persistent random value in
# production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`) or
# every server restart logs everyone out. Local dev works fine without setting
# this at all (a fresh one's generated automatically each run).
SESSION_SECRET_KEY=

# Only a Google account with this email domain can sign in at all. Defaults to
# peppercontent.io if left blank.
ALLOWED_EMAIL_DOMAIN=
